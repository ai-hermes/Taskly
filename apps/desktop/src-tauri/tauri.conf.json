{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Taskly",
  "version": "0.1.0",
  "identifier": "com.taskly.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Taskly",
        "width": 1080,
        "height": 720,
        "minWidth": 840,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'; connect-src 'self' http://localhost:11434 https://api.openai.com http://localhost:8080 ws://localhost:1420;",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/screenshots/**", "$TEMP/taskly_screenshot_*.png"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["models", "binaries/pi-package"],
    "externalBin": ["binaries/pi-coding-agent"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
