{
  "name": "@taskly/core",
  "version": "0.1.0",
  "private": true,
  "description": "Taskly shared core: todo model, LLM extraction, and dedup logic (framework-agnostic).",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
